# TestCall configuration.
#
# Copy to .env and fill in. .env is gitignored and must stay that way — these
# are live vendor credentials.
#
#   cp .env.example .env

# ---------------------------------------------------------------- the basics

PORT=3000

# The kill switch, and it defaults to OFF.
#
# Copied from production, where a feature that dials real phones is opt-in per
# deployment. Left unset, placing a call fails with "Confirmation calling is
# turned off", which reads like a broken app if you do not know this line exists.
CONSULT_CALL_ENABLED=true

# The public https origin Twilio posts its webhooks back to.
#
# Localhost is unreachable from Twilio, so local testing needs a tunnel:
#
#   ngrok http 3000
#
# then paste the https forwarding origin here, WITHOUT a trailing slash, and
# restart the server. This value is also what signature validation rebuilds the
# signed URL from, so if it does not match what Twilio actually hit — wrong
# subdomain, a stale tunnel, a trailing slash — every webhook 403s and the call
# is silently hung up.
PUBLIC_WEBHOOK_BASE_URL=https://your-tunnel.ngrok-free.app

# ---------------------------------------------------------------------- Twilio

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Must be voice-capable. An SMS-only number will not place calls; `npm run
# verify` checks this for you.
TWILIO_VOICE_FROM_NUMBER=
# Fallback sender if TWILIO_VOICE_FROM_NUMBER is unset.
TWILIO_PHONE_NUMBER=

# ---------------------------------------------------------------------- OpenAI

OPENAI_API_KEY=
OPENAI_RESPONSES_MODEL=gpt-5.4
# OPENAI_BASE_URL=
OPENAI_TIMEOUT_MS=30000

# ------------------------------------------------------------------ ElevenLabs

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Clamped to 0.7–1.2. Below 1 on purpose: the stock rate reads a confirmation at
# presenter pace, which is too fast on a phone.
ELEVENLABS_SPEED=0.9

# -------------------------------------------------------- S3 (audio hosting)
#
# ElevenLabs returns raw mp3 bytes and Twilio's <Play> can only fetch a URL, so
# the clips are stored here and served as presigned URLs. The cache key is
# content-addressed over voice + model + speed + text, so pointing this at an
# existing bucket shares the clip cache safely.

AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------ call behaviour

# Calling hours on the callee's clock. Inclusive start, exclusive end, so 20:59
# is fine and 21:00 is not. The page can override per call.
CONSULT_CALL_HOURS_START=8
CONSULT_CALL_HOURS_END=21

# Whether a call may go out in Twilio's stock voice. Defaults to REFUSING, and
# only the literal string 'false' turns that off.
#
# So with ElevenLabs unconfigured the dial is refused outright rather than
# quietly degrading to Polly — deliberate, because a stock robot reading a
# script that introduces itself by name is worse than no call at all. Set this
# to false to hear the fallback path, or to ride out an ElevenLabs outage.
CONSULT_CALL_REQUIRE_REAL_VOICE=true

# How long the consult is said to run, when the caller asks. Blank or 0 makes
# the assistant say it is not sure, which is honest.
CONSULT_DURATION_MINUTES=60

# ------------------------------------------------------- conversation tuning

# Blank uses OPENAI_RESPONSES_MODEL. The override is for tuning latency, which
# is what matters on a phone: a reasoning model spends seconds thinking, and
# those seconds are silence on the line.
CONSULT_CALL_CONVERSATION_MODEL=
CONSULT_CALL_CONVERSATION_EFFORT=low

# Twilio abandons a webhook at roughly fifteen seconds and plays its own error
# recording. These two ADD rather than max — synthesis is awaited after the
# model deadline — so 8000 + 5000 is already close to the cliff. Raising the
# reply timeout past ~9000 will push real calls over it.
CONSULT_CALL_CONVERSATION_REPLY_TIMEOUT_MS=8000
CONSULT_CALL_CONVERSATION_VOICE_TIMEOUT_MS=5000

# A guardrail against a voicemail greeting keeping the line open, not a length
# any real conversation approaches.
CONSULT_CALL_CONVERSATION_MAX_TURNS=14

# Seconds of silence that end the caller's turn, or 'auto' for Twilio's own
# end-of-speech model. `auto` is more accurate and noticeably slower — it is the
# single largest piece of the gap between someone finishing a sentence and
# hearing a reply. Use 'auto' if callers are being cut off mid-thought.
CONSULT_CALL_CONVERSATION_SPEECH_TIMEOUT=1
